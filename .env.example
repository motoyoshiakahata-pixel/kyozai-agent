# Anthropic API
ANTHROPIC_API_KEY=

# Google OAuth (Google Drive アクセス用)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# セッション/トークン暗号化用シークレット
AUTH_SECRET=

# Google Drive MCPサーバーURL（Anthropic APIのmcp_serversに渡す）。
# 省略可。Vercelでは未設定の場合、自動的に自分自身のデプロイURL配下の
# /api/mcp（このアプリに組み込みのMCPサーバー）を使う。
# ローカル開発や外部の別MCPサーバーを使う場合のみ明示的に設定する。
GOOGLE_DRIVE_MCP_SERVER_URL=
