# Anthropic API
ANTHROPIC_API_KEY=

# Google OAuth (Google Drive アクセス用)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 省略可。未設定の場合、アクセス中のURLから自動的に組み立てます
# （例: https://<your-app>.vercel.app/api/auth/callback）。
# 自動判別された値はアプリ画面の「セットアップ状況」カードに表示されます。
GOOGLE_REDIRECT_URI=

# セッション/トークン暗号化用シークレット
AUTH_SECRET=

# Google Drive MCPサーバーURL（Anthropic APIのmcp_serversに渡す）。
# 省略可。未設定の場合、アクセス中のURL配下の /api/mcp（このアプリに組み込みの
# MCPサーバー）を自動的に使う。Anthropic側から到達できる必要があるため、
# ローカル開発ではhttps到達可能なURLを明示的に設定する。
GOOGLE_DRIVE_MCP_SERVER_URL=
